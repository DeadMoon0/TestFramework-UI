<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>

		<!-- One framework's browser fleet at a time. Both target frameworks at once means two Edge fleets
		     and two test hosts on one machine, and the delayed-page waits - real seconds by design - start
		     missing their windows. Sequential is slower and honest; parallel was flaky and lying. -->
		<TestTfmsInParallel>false</TestTfmsInParallel>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="coverlet.collector" Version="6.0.0" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
		<PackageReference Include="xunit" Version="2.5.3" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\TestFramework.UI.Browser\TestFramework.UI.Browser.csproj" />
		<ProjectReference Include="..\TestFramework.UI.SampleWebApp\TestFramework.UI.SampleWebApp.csproj" />
	</ItemGroup>

	<!-- The fixture starts the sample application in this process, so it compiles against the web stack. -->
	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="Xunit" />
	</ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Title>TestFramework.UI.Web</Title>
		<Authors>DeadMoon0</Authors>
		<Product>TestFramework</Product>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageTags>Test;UnitTest;IntegrationTest;Framework;Fluent;Timeline;UI;Browser;Playwright;Web;Rest;Api</PackageTags>
		<PackageIcon>Icon.png</PackageIcon>
		<Description>Points browser steps at the application the TestFramework.Web package family already configures. A web app identifier can take its base address from a configured REST API identifier, and the browser step declares the same environment requirement as the API steps - so one provisioned application serves both doors of the same timeline.</Description>
		<Version>0.1.0</Version>
		<PackageProjectUrl>https://github.com/DeadMoon0/TestFramework-UI</PackageProjectUrl>
		<RepositoryUrl>https://github.com/DeadMoon0/TestFramework-UI.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<Copyright>Copyright (c) DeadMoon0 2026</Copyright>
		<PackageReleaseNotes>First release. Browser steps resolve their application from the Web family's configuration: an identifier shared with a configured site resolves by itself, FromWebApi covers an application the API process serves, FromSite covers a name mismatch. Requires TestFramework.UI.Browser 0.1.0 and TestFramework.Web 0.4.0.</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>TestFramework.UI.Web.Tests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="TestFramework.Web" Version="0.4.0" />
		<PackageReference Include="TestFramework.Config" Version="0.2.1" />
		<PackageReference Include="TestFramework.Core" Version="0.3.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\TestFramework.UI.Browser\TestFramework.UI.Browser.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\Modules\TestFramework-Common\Assets\Icon.png" Condition="Exists('..\Modules\TestFramework-Common\Assets\Icon.png')">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<Target Name="EnsurePackageIconPresent" BeforeTargets="GenerateNuspec">
		<Error Condition="!Exists('..\Modules\TestFramework-Common\Assets\Icon.png')"
		       Text="The package icon is missing because the TestFramework-Common submodule is not checked out. Run: git submodule update --init --recursive" />
	</Target>

</Project>

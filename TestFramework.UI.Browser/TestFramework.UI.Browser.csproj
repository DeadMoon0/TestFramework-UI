<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Title>TestFramework.UI.Browser</Title>
		<Authors>DeadMoon0</Authors>
		<Product>TestFramework</Product>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageTags>Test;UnitTest;IntegrationTest;Framework;Fluent;Timeline;UI;Browser;Playwright;WebUI;E2E</PackageTags>
		<PackageIcon>Icon.png</PackageIcon>
		<Description>Drive a local browser from inside a TestFramework timeline. Interactions read as imperative steps (Navigate, Click, Fill, Expect) and address elements the way a person does - by role, label, placeholder or visible text - so a renamed or relocated control does not fail a test that only wanted to press it. Every non-exact match is recorded and assertable, ambiguity fails with the candidates and the dial that resolves it, and expected page structure is declared as a typed, reusable field.</Description>
		<Version>0.2.0</Version>
		<PackageProjectUrl>https://github.com/DeadMoon0/TestFramework-UI</PackageProjectUrl>
		<RepositoryUrl>https://github.com/DeadMoon0/TestFramework-UI.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<Copyright>Copyright (c) DeadMoon0 2026</Copyright>
		<PackageReleaseNotes>Browser evidence is now recorded as the run's own widgets, attributed to the step and the attempt that produced them. The pack's own failure folder is gone, so anything that read that folder should read the run's output instead. A paused run can also be asked to photograph every session it has open. Requires TestFramework.Core 0.5.0 and TestFramework.Config 0.3.0.</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<!-- This package's own suite, and nobody else. The bridge package's suite used to be granted this
		     too, to drive the address resolver - which is this package's, so those cases moved to this
		     package's suite instead. A grant to another package's suite is the same private handshake as a
		     grant to the package: it lets one suite reach what every other suite cannot. -->
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>TestFramework.UI.Browser.Tests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Playwright" Version="1.62.0" />
		<!-- Named rather than taken transitively from Core: this package reads the page's answers
		     itself, so the one JSON library the family uses is a dependency it declares. -->
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
		<PackageReference Include="TestFramework.Config" Version="0.3.0" />
		<PackageReference Include="TestFramework.Core" Version="0.5.0" />
	</ItemGroup>

	<!--
	  Sibling package inside this repository. The produced nuspec declares it as a version-pinned
	  dependency, the same way a consumer resolves it; only the build inside the repo short-circuits
	  to the project.
	-->
	<ItemGroup>
	</ItemGroup>

	<ItemGroup>
		<None Include="..\Modules\TestFramework-Common\Assets\Icon.png" Condition="Exists('..\Modules\TestFramework-Common\Assets\Icon.png')">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<Target Name="EnsurePackageIconPresent" BeforeTargets="GenerateNuspec">
		<Error Condition="!Exists('..\Modules\TestFramework-Common\Assets\Icon.png')"
		       Text="The package icon is missing because the TestFramework-Common submodule is not checked out. Run: git submodule update --init --recursive" />
	</Target>

</Project>
